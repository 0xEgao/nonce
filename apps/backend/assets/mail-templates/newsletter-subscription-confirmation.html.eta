<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <%~ include('./_dark-scheme-head.html.eta') %>
  <title>Confirm Your Subscription</title>
</head>
<body bgcolor="#111111" style="margin:0; padding:0; background-color:#111111; font-family:system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">

  <table bgcolor="#111111" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#111111; padding:24px 0;">
    <tr>
      <td align="center">

        <table bgcolor="#1b1b1b" width="600" cellpadding="0" cellspacing="0" border="0" style="background-color:#1b1b1b; border-radius:16px; overflow:hidden;">
          <tr>
            <td bgcolor="#000000" align="center" style="background-color:#000000; padding:24px 24px 20px 24px;">
              <h1 style="margin:0; font-size:24px; color:#ffffff; font-weight:700;">
                Confirm Your Subscription
              </h1>
              <p style="margin:8px 0 0 0; font-size:14px; color:#f9b233; font-weight:500;">
                Bitshala Newsletters
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:24px 32px 16px 32px; color:#eaeaea; font-size:14px; line-height:1.6;">
              <p style="margin:0 0 12px 0;">
                Hi there,
              </p>

              <p style="margin:0 0 16px 0;">
                Someone, hopefully you, asked to receive
                <strong style="color:#f9b233;"><%= it.listNames %></strong>
                from Bitshala at this address. Confirm below and we'll start
                sending them your way.
              </p>
            </td>
          </tr>

          <tr>
            <td align="center" style="padding:8px 32px 8px 32px;">
              <table cellpadding="0" cellspacing="0" border="0" align="center">
                <tr>
                  <td align="center" bgcolor="#f7931a" style="border-radius:999px;">
                    <a href="<%= it.confirmUrl %>"
                       style="display:inline-block; padding:14px 32px; font-size:15px; font-weight:600; color:#000000; text-decoration:none;">
                      Confirm Subscription
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:16px 32px 0 32px; color:#bdbdbd; font-size:12px; line-height:1.6;">
              <p style="margin:0;">
                If the button doesn't work, copy and paste this link into your browser:<br />
                <a href="<%= it.confirmUrl %>" style="color:#f9b233; text-decoration:underline; word-break:break-all;"><%= it.confirmUrl %></a>
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:16px 32px 32px 32px; color:#eaeaea; font-size:14px; line-height:1.6;">
              <p style="margin:0;">
                Didn't ask for this? Just ignore this email and you won't be
                subscribed to anything.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
